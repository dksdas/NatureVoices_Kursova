<Window x:Class="аудіобібліотека_голоси_природи.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мої плейлисти" Height="620" Width="860"
        Background="#121212" ResizeMode="CanResize" MinHeight="540" MinWidth="760"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="BgMain"    Color="#121212"/>
        <SolidColorBrush x:Key="BgCard"    Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BgSide"    Color="#181818"/>
        <SolidColorBrush x:Key="Accent"    Color="#1DB954"/>
        <SolidColorBrush x:Key="TextMain"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSub"   Color="#B3B3B3"/>
        <SolidColorBrush x:Key="TextGreen" Color="#78A678"/>

        <!-- Scrollbar slim -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="OverridesDefaultStyle" Value="true"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Rectangle Fill="#78A678" RadiusX="3" RadiusY="3" Opacity="0.6"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill button -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,6"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Playlist list item -->
        <Style x:Key="PlaylistItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" Margin="0,3" Padding="12,10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1DB95433"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1DB954"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox green -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Playlist list -->
        <Border Grid.Column="0" Background="#181818" CornerRadius="0,20,20,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="🎵 МОІ ПЛЕЙЛИСТИ"
                               Foreground="#78A678" FontSize="11" FontWeight="Bold" Margin="4,0,0,12"/>
                    <Button x:Name="BtnNewPlaylist" Content="+ Новий плейлист"
                            Style="{StaticResource PillBtn}"
                            Background="#1DB954" FontSize="13" FontWeight="Bold"
                            Height="38" Click="BtnNewPlaylist_Click"/>
                </StackPanel>

                <!-- List -->
                <ListBox x:Name="PlaylistListBox" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource PlaylistItemStyle}"
                         SelectionChanged="PlaylistListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Emoji}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Play selected playlist -->
                <Button x:Name="BtnPlayThis" Grid.Row="2" Content="▶ Грати плейлист"
                        Style="{StaticResource PillBtn}" Background="#282828"
                        Foreground="#1DB954" FontSize="13" FontWeight="Bold"
                        Height="38" Margin="0,12,0,0" Click="BtnPlayThis_Click"/>
            </Grid>
        </Border>

        <!-- RIGHT: Editor -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <TextBlock x:Name="EditorTitle" Grid.Row="0"
                       Text="Оберіть або створіть плейлист"
                       Foreground="#B3B3B3" FontSize="14" Margin="0,0,0,16"/>

            <!-- Name + Emoji row -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Emoji picker button -->
                <Border Background="#1E1E1E" CornerRadius="10" Margin="0,0,10,0">
                    <Button x:Name="BtnEmoji" Background="Transparent" BorderThickness="0"
                            Height="46" FontSize="26" Cursor="Hand"
                            Click="BtnEmoji_Click" ToolTip="Gliknij, aby sminiti emoji">
                        <TextBlock x:Name="EmojiDisplay" Text="🎵" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Border>

                <!-- Playlist name -->
                <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="10">
                    <TextBox x:Name="TxtName" Background="Transparent" BorderThickness="0"
                             Foreground="White" FontSize="16" FontWeight="Bold"
                             Padding="14,0" VerticalContentAlignment="Center" Height="46"
                             Text="Новий плейлист"
                             CaretBrush="White"/>
                </Border>
            </Grid>

            <!-- Two-column: Categories + Tracks -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CATEGORIES -->
                <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="🌿 КАТЕГОРІЇ"
                                   Foreground="#78A678" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="CategoriesPanel">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Foreground="White" FontSize="13"
                                                  Margin="0,5" Cursor="Hand"
                                                  Checked="CategoryChecked" Unchecked="CategoryChecked"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- TRACKS -->
                <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="🎶 ТРЕКИ"
                                   Foreground="#78A678" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                        <!-- Quick filter -->
                        <Border Grid.Row="1" Background="#282828" CornerRadius="8" Margin="0,0,0,10">
                            <TextBox x:Name="TrackFilter" Background="Transparent" BorderThickness="0"
                                     Foreground="White" FontSize="12" Padding="10,5"
                                     VerticalContentAlignment="Center" Height="32"
                                     CaretBrush="White" TextChanged="TrackFilter_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TracksPanel">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Foreground="White" FontSize="12"
                                                  Margin="0,4" Cursor="Hand"
                                                  Checked="TrackChecked" Unchecked="TrackChecked"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom action buttons -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnSave" Grid.Column="0" Content="💾 Зберегти плейлист"
                        Style="{StaticResource PillBtn}" Background="#1DB954"
                        FontSize="14" FontWeight="Bold" Height="44" Click="BtnSave_Click"/>
                <Button x:Name="BtnDelete" Grid.Column="2" Content="🗑 Видалити"
                        Style="{StaticResource PillBtn}" Background="#C0392B"
                        FontSize="14" Height="44" Width="120" Click="BtnDelete_Click"
                        Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

<Window x:Class="аудіобібліотека_голоси_природи.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Аудіобібліотека" Height="650" Width="950" 
        x:Name="RootWindow" Background="#121212"
        ResizeMode="CanResize" MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="WindowBackground" Color="#121212"/>
        <SolidColorBrush x:Key="CardBackground" Color="#282828"/>
        <SolidColorBrush x:Key="PrimaryText" Color="White"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#B3B3B3"/>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="{x:Type Thumb}">
                                                <Setter Property="OverridesDefaultStyle" Value="true"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Rectangle Fill="#78A678" RadiusX="4" RadiusY="4" Opacity="0.5"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ForestButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#282828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                           Background="{TemplateBinding Background}" 
                                           BorderBrush="{TemplateBinding BorderBrush}" 
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           Focusable="false" 
                                           IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,30,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Name="DropDownBorder" Background="#282828" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="10" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT SIDEBAR ===== -->
        <Border x:Name="SidePanel" Grid.Column="0" Background="#E0EEE0" CornerRadius="0,30,30,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,35">
                        <TextBlock Text="&#127807;" FontSize="26" Margin="0,0,10,0"/>
                        <TextBlock x:Name="LogoText" Text="Голоси природи" Foreground="{DynamicResource PrimaryText}" FontSize="19" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="МЕНЮ" Foreground="#78A678" FontSize="11" FontWeight="Bold" Margin="12,0,0,12"/>

                        <!-- Home -->
                        <Button x:Name="BtnHome" Content="&#127968; Головна" Style="{StaticResource ForestButtonStyle}" Background="#C8E6C8" Click="Filter_Click"/>

                        <!-- Favorites -->
                        <Button x:Name="BtnFavorites" Content="&#10084;&#65039; Мої улюблені" Style="{StaticResource ForestButtonStyle}" Click="Favorites_Click" Margin="0,5,0,0"/>

                        <!-- Playlists  (NEW) -->
                        <Button x:Name="BtnPlaylists" Content="&#127925; Мої плейлисти" Style="{StaticResource ForestButtonStyle}" Click="BtnPlaylists_Click" Margin="0,5,0,0"/>

                        <!-- Category list -->
                        <ListBox x:Name="CategoryListBox" Background="Transparent" BorderThickness="0" Margin="0,5,0,0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="CategoryListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" CornerRadius="12" Margin="0,2">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#D0EAD0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#C8E6C8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="210" Height="45">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="15,0" FontSize="14" Foreground="{DynamicResource PrimaryText}"/>
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Видалити" Click="DeleteCategory_Click" Foreground="Red" 
                                                          Visibility="{Binding DataContext.AdminControlsVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Content="+ Додати категорію" Foreground="#78A678" FontSize="12" Margin="12,15,0,0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" 
                                Visibility="{Binding AdminControlsVisibility}" Click="AddCategory_Click"/>
                    </StackPanel>

                    <!-- Sleep timer -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,20">
                        <TextBlock Text="&#9200; ТАЙМЕР СНУ" Foreground="#78A678" FontSize="11" FontWeight="Bold" Margin="12,0,0,8"/>
                        <ComboBox x:Name="SleepTimerBox" Height="35" SelectionChanged="SleepTimerBox_SelectionChanged" Background="#282828" Foreground="White" BorderThickness="1" BorderBrush="#3E3E3E" Margin="0,0,0,15">
                            <ComboBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Вимкнено" IsSelected="True" Background="#282828" Foreground="White"/>
                            <ComboBoxItem Content="15 хв" Background="#282828" Foreground="White"/>
                            <ComboBoxItem Content="30 хв" Background="#282828" Foreground="White"/>
                            <ComboBoxItem Content="60 хв" Background="#282828" Foreground="White"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Day / Night theme switcher -->
                    <Border Grid.Row="3" x:Name="ThemePanel" Background="#282828" CornerRadius="22" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DayBtn" Grid.Column="0" Background="Transparent" Height="34" Click="DayButton_Click" BorderThickness="0">
                                <TextBlock x:Name="DayBtnText" Text="&#9728;&#65039; День" Foreground="#B3B3B3" FontSize="12"/>
                            </Button>
                            <Button x:Name="NightBtn" Grid.Column="1" Background="#1DB954" Height="34" Click="NightButton_Click" BorderThickness="0">
                                <TextBlock x:Name="NightBtnText" Text="&#127769; Ніч" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title + Search -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="MainTitle" Text="Бібліотека звуків" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                <Border x:Name="SearchBorder" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10,5">
                    <Grid>
                        <TextBlock Text="Пошук треків..." Foreground="{DynamicResource SecondaryText}" FontSize="14" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="{DynamicResource PrimaryText}" TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Track list + Admin panel -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Admin panel -->
                <Border x:Name="AdminPanel" Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="15" Padding="15" Margin="0,0,0,15" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewTrackTitle" Margin="0,0,5,0" Height="25" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"/>
                        <TextBox x:Name="NewTrackCategory" Grid.Column="1" Margin="0,0,5,0" Height="25" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"/>
                        <Button Grid.Column="2" Content="&#128193; Додати трек" Padding="10,0" Click="AddTrack_Click"/>
                    </Grid>
                </Border>

                <!-- Track list -->
                <ListBox x:Name="SoundsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" BorderThickness="0" Margin="0">
                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackground}" CornerRadius="15" Margin="0,0,10,12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="PlayButton_Click" Background="#1DB954" Foreground="Black" BorderThickness="0" Width="40" Height="40" Content="&#9654;" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style>
                                        </Button.Resources>
                                    </Button>
                                    <StackPanel Grid.Column="1" Margin="15,0">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                        <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#78A678"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource SecondaryText}"/>
                                    <Button Click="Favorite_Click" Content="{Binding FavoriteIcon}" Background="Transparent" Foreground="#FF3B30" FontSize="18" Width="35" Height="35" BorderThickness="0" Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Grid.Column="4" Content="&#128465;" Click="DeleteTrack_Click" Background="#FFE5E5" Foreground="#D63031" Width="30" Height="30" BorderThickness="0"
                                            Visibility="{Binding DataContext.AdminControlsVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Player bar -->
            <Border x:Name="PlayerBar" Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="25" Margin="0,15,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <!-- Now playing -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NowPlayingLabel" Text="Зараз грає:" FontSize="10" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock x:Name="PlayingNow" Text="..." FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryText}"/>
                    </StackPanel>

                    <!-- Controls + timeline -->
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="&#9198;" Click="Prev_Click" Background="Transparent" BorderThickness="0" FontSize="20" Foreground="{DynamicResource PrimaryText}"/>
                            <Button x:Name="BtnPlayPause" Width="40" Height="40" Margin="15,0" Click="PlayPause_Click" Background="#1B261E" Foreground="White">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style>
                                </Button.Resources>
                                <TextBlock x:Name="PlayPauseIcon" Text="&#9654;"/>
                            </Button>
                            <Button Content="&#9197;" Click="Next_Click" Background="Transparent" BorderThickness="0" FontSize="20" Foreground="{DynamicResource PrimaryText}"/>
                            <!-- Shuffle button: green = on, white = off -->
                            <Button x:Name="ShuffleBtn" Content="&#128256;" Click="Random_Click"
                                    Background="Transparent" BorderThickness="0" FontSize="18"
                                    Foreground="{DynamicResource PrimaryText}"
                                    Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                    ToolTip="Перемішування вимкнено"/>
                        </StackPanel>
                        <Slider x:Name="TimelineSlider" Margin="0,5,0,0" Minimum="0" IsMoveToPointEnabled="True"
                                ValueChanged="TimelineSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="TimelineSlider_MouseDown"/>
                        <TextBlock x:Name="TimeStatus" Text="0:00 / 0:00" FontSize="10" HorizontalAlignment="Center" Foreground="#78A678"/>
                    </StackPanel>

                    <!-- Volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="VolIcon" Text="&#128266;" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryText}"/>
                        <Slider Width="100" Minimum="0" Maximum="1" Value="0.8" IsMoveToPointEnabled="True"
                                ValueChanged="Volume_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
